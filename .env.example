# Скопировать в .env на VPS и заполнить. .env — в .gitignore.
# Комментарии только отдельными строками: в env_file хвостовой «# …» может попасть в значение.

# адрес веба — для ссылок входа из бота (/login)
PUBLIC_URL=https://lifetask.ru

POSTGRES_PASSWORD=
# openssl rand -hex 32
API_TOKEN=

# от @BotFather
TG_TOKEN=
# пусто при первом запуске: бот сам пришлёт твой chat id
TG_OWNER_ID=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# xray из tryberry (Anthropic/Groq из РФ напрямую не отвечают); пусто — напрямую
AI_PROXY_URL=http://pt_xray:8888
TG_PROXY_URL=
TRYBERRY_NETWORK=tryberrybot_default

# Google Calendar/Tasks — тот же OAuth-клиент, что в tryberry (его .env: GOOGLE_CLIENT_ID/SECRET).
# Доступ выдаётся один раз: docker compose exec -it app lifeplan google-auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROXY_URL=
